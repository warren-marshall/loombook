NODE_ENV=development
PORT=3003

# Local Supabase (`npx supabase start`). Print the real values with
# `npx supabase status -o env`; for a hosted project use its dashboard values.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-with-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Postgres connection used by TypeORM (local Supabase defaults).
DB_HOST=127.0.0.1
DB_PORT=54322
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=postgres
